{
  "name": "@teemate/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=../.env dist/src/main.js\"",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../.env dist/src/db/migrate.js",
    "admin:create": "node --env-file-if-exists=../.env dist/scripts/create-admin.js",
    "sign-in-link": "node --env-file-if-exists=../.env dist/scripts/sign-in-link.js",
    "course-image": "node --env-file-if-exists=../.env dist/scripts/add-course-image.js",
    "demo-season": "node --env-file-if-exists=../.env dist/scripts/demo-season.js",
    "course-cards": "node --env-file-if-exists=../.env dist/scripts/import-course-cards.js",
    "season-photo": "node --env-file-if-exists=../.env dist/scripts/add-season-photo.js",
    "import:history": "node --env-file-if-exists=../.env dist/scripts/import-history.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@teemate/shared": "workspace:*",
    "@tesseract.js-data/eng": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0"
  },
  "type": "module"
}
